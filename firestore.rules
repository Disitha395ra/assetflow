rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["it@scot.lk", "admin@scot.lk"]
        && request.auth.token.email_verified == true;
    }

    match /assets/{assetId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();

      match /history/{eventId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    match /movements/{movementId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /settings/requirement-window {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /settings/departments {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /requirements/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          "id", "department", "item", "quantity", "neededDate",
          "reason", "requesterName", "requesterEmail", "status", "createdAt"
        ])
        && request.resource.data.status == "Pending"
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 500
        && request.resource.data.item is string
        && request.resource.data.reason is string
        && get(/databases/$(database)/documents/settings/requirement-window).data.isOpen == true
        && request.time >= get(/databases/$(database)/documents/settings/requirement-window).data.opensAt
        && request.time <= get(/databases/$(database)/documents/settings/requirement-window).data.closesAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
